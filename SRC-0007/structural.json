{
  "src": "SRC-0007",
  "schema_version": "2.0",
  "lens": "structural",
  "compositions": [
    {
      "id": "SRC-0007/entity/rollout-file",
      "src": "SRC-0007",
      "composition": "entity",
      "terms": {
        "object": "Rollout file — JSONL-файл истории Codex-сессии (thread), хранящий SessionMeta + последовательность items для replay/resume/inspect",
        "attributes": [
          "path: абсолютный путь к файлу",
          "filename pattern: rollout-YYYY-MM-DDThh-mm-ss-<uuid>.jsonl (ROLLOUT_PREFIX='rollout-', ROLLOUT_SUFFIX='.jsonl')",
          "created_at: RFC3339 timestamp (секундная точность из filename)",
          "updated_at: RFC3339 timestamp (из file mtime, miллисекундная точность)",
          "thread_id: ThreadId (UUID, извлекается из session meta)",
          "первая строка: SessionMetaLine (meta + git)",
          "последующие строки: RolloutLine { timestamp, item } в JSONL формате",
          "directory layout: NestedByDate (~/.codex/sessions/YYYY/MM/DD/) или Flat"
        ],
        "relationships": [
          {"to": "SRC-0007/entity/session-meta-line", "rel": "contains", "card": "1:1"},
          {"to": "SRC-0007/entity/rollout-item", "rel": "contains", "card": "1:N"},
          {"to": "SRC-0007/entity/thread-metadata-row", "rel": "reconciles_to", "card": "1:1"}
        ],
        "enumerations": null,
        "data_flows": [
          {"source": "RolloutRecorder.record_items", "transform": "is_persisted_response_item filter + sanitize_rollout_item_for_persistence", "sink": "rollout .jsonl (append)"},
          {"source": "rollout .jsonl (read)", "transform": "RolloutRecorder.load_rollout_items (parse lines, extract thread_id from first SessionMeta)", "sink": "InitialHistory::Resumed { conversation_id, history, rollout_path }"}
        ],
        "config": null
      }
    },
    {
      "id": "SRC-0007/entity/session-meta",
      "src": "SRC-0007",
      "composition": "entity",
      "terms": {
        "object": "SessionMeta — заголовочная запись thread (первая строка rollout-файла), описывающая параметры сессии",
        "attributes": [
          "id: ThreadId",
          "forked_from_id: Option<ThreadId> — thread-источник если это форк",
          "timestamp: строка (формат [year]-[month]-[day]T[hour]:[minute]:[second].[subsecond digits:3]Z)",
          "cwd: PathBuf (рабочая директория на момент старта сессии)",
          "originator: строка (из default_client originator())",
          "cli_version: строка (CARGO_PKG_VERSION)",
          "agent_nickname: Option<String>",
          "agent_role: Option<String>",
          "agent_path: Option<String>",
          "source: SessionSource",
          "model_provider: Option<String>",
          "base_instructions: Option<BaseInstructions>",
          "dynamic_tools: Option<Vec<DynamicToolSpec>>",
          "memory_mode: Option<String> ('disabled' если generate_memories=false, иначе None/'enabled')"
        ],
        "relationships": [
          {"to": "SRC-0007/entity/session-meta-line", "rel": "wrapped_in", "card": "1:1"},
          {"to": "SRC-0007/entity/git-info", "rel": "associated_with", "card": "1:0..1"}
        ],
        "enumerations": null,
        "data_flows": [
          {"source": "RolloutRecorderParams::Create (conversation_id, forked_from_id, source, base_instructions, dynamic_tools)", "transform": "RolloutRecorder::new — построение SessionMeta с добавлением timestamp, cwd, originator, cli_version, agent fields из source, model_provider, memory_mode", "sink": "write_session_meta → SessionMetaLine → rollout file первая строка"}
        ],
        "config": null
      }
    },
    {
      "id": "SRC-0007/entity/session-meta-line",
      "src": "SRC-0007",
      "composition": "entity",
      "terms": {
        "object": "SessionMetaLine — контейнер SessionMeta + GitInfo, сериализуется первой строкой rollout-файла",
        "attributes": [
          "meta: SessionMeta",
          "git: Option<ProtocolGitInfo> (commit_hash, branch, repository_url)"
        ],
        "relationships": [
          {"to": "SRC-0007/entity/session-meta", "rel": "contains", "card": "1:1"},
          {"to": "SRC-0007/entity/rollout-item", "rel": "is_variant_of", "card": "N:1"}
        ],
        "enumerations": null,
        "data_flows": [
          {"source": "collect_git_info(cwd)", "transform": "map to ProtocolGitInfo", "sink": "SessionMetaLine.git"}
        ],
        "config": null
      }
    },
    {
      "id": "SRC-0007/entity/rollout-item",
      "src": "SRC-0007",
      "composition": "entity",
      "terms": {
        "object": "RolloutItem — элемент rollout-файла (вариант enum, представляет один тип события в истории thread)",
        "attributes": [
          "variant: SessionMeta(SessionMetaLine) | ResponseItem(ResponseItem) | Compacted(CompactedItem) | TurnContext(TurnContext) | EventMsg(EventMsg)"
        ],
        "relationships": [
          {"to": "SRC-0007/entity/rollout-file", "rel": "appended_to", "card": "N:1"}
        ],
        "enumerations": {
          "variants": ["SessionMeta", "ResponseItem", "Compacted", "TurnContext", "EventMsg"]
        },
        "data_flows": [
          {"source": "record_items(items)", "transform": "is_persisted_response_item filter по policy (ResponseItem / EventMsg mode-зависимо / Compacted|TurnContext|SessionMeta всегда persist)", "sink": "pending_items → JsonlWriter.write_rollout_item"},
          {"source": "RolloutItem::EventMsg(ExecCommandEnd) в Extended режиме", "transform": "sanitize_rollout_item_for_persistence: aggregated_output truncate_middle_chars(10_000 bytes); stdout/stderr/formatted_output cleared", "sink": "persisted EventMsg::ExecCommandEnd с truncated output"}
        ],
        "config": null
      }
    },
    {
      "id": "SRC-0007/entity/rollout-recorder",
      "src": "SRC-0007",
      "composition": "entity",
      "terms": {
        "object": "RolloutRecorder — handle для записи rollout-файла одной thread (обёртка над фоновой writer-task + MPSC-каналом)",
        "attributes": [
          "tx: Sender<RolloutCmd>",
          "writer_task: Arc<RolloutWriterTask> (handle + terminal_failure)",
          "rollout_path: PathBuf",
          "state_db: Option<StateDbHandle>",
          "event_persistence_mode: EventPersistenceMode"
        ],
        "relationships": [
          {"to": "SRC-0007/entity/rollout-file", "rel": "writes", "card": "1:1"},
          {"to": "SRC-0007/entity/rollout-writer-state", "rel": "delegates_to", "card": "1:1"},
          {"to": "SRC-0007/entity/thread-metadata-row", "rel": "syncs_to", "card": "1:1"}
        ],
        "enumerations": null,
        "data_flows": [
          {"source": "record_items → MPSC channel (capacity 256)", "transform": "rollout_writer task processes RolloutCmd::{AddItems,Persist,Flush,Shutdown}", "sink": "RolloutWriterState.pending_items → JsonlWriter → файл"}
        ],
        "config": null
      }
    },
    {
      "id": "SRC-0007/entity/rollout-recorder-params",
      "src": "SRC-0007",
      "composition": "entity",
      "terms": {
        "object": "RolloutRecorderParams — входные параметры создания RolloutRecorder (Create или Resume)",
        "attributes": [
          "Create { conversation_id: ThreadId, forked_from_id: Option<ThreadId>, source: SessionSource, base_instructions: BaseInstructions, dynamic_tools: Vec<DynamicToolSpec>, event_persistence_mode: EventPersistenceMode }",
          "Resume { path: PathBuf, event_persistence_mode: EventPersistenceMode }"
        ],
        "relationships": [
          {"to": "SRC-0007/entity/rollout-recorder", "rel": "constructs", "card": "1:1"}
        ],
        "enumerations": {
          "variants": ["Create", "Resume"]
        },
        "data_flows": null,
        "config": null
      }
    },
    {
      "id": "SRC-0007/entity/rollout-writer-state",
      "src": "SRC-0007",
      "composition": "entity",
      "terms": {
        "object": "RolloutWriterState — внутреннее состояние фоновой writer-task (буфер pending_items + recovery)",
        "attributes": [
          "writer: Option<JsonlWriter>",
          "deferred_log_file_info: Option<LogFileInfo> (path, conversation_id, timestamp для отложенной материализации)",
          "pending_items: Vec<RolloutItem> (элементы в буфере, не дописанные в файл)",
          "meta: Option<SessionMeta> (будет записано как первая строка при первом write)",
          "cwd: PathBuf",
          "rollout_path: PathBuf",
          "state_db_ctx: Option<StateDbHandle>",
          "state_builder: Option<ThreadMetadataBuilder>",
          "default_provider: String",
          "generate_memories: bool",
          "last_logged_error: Option<String> (deduplication сообщений об ошибке записи)"
        ],
        "relationships": [
          {"to": "SRC-0007/entity/rollout-file", "rel": "writes", "card": "1:1"},
          {"to": "SRC-0007/entity/rollout-item", "rel": "buffers", "card": "1:N"}
        ],
        "enumerations": null,
        "data_flows": [
          {"source": "pending_items", "transform": "write_pending_once: ensure_writer_open → write_session_meta_if_needed → write_pending_items_once → flush", "sink": "JsonlWriter → async file"},
          {"source": "write error (any step)", "transform": "enter_recovery_mode (writer=None, last_logged_error recorded); retry once через write_pending_with_recovery", "sink": "pending_items retained (suffix не списанных элементов)"}
        ],
        "config": null
      }
    },
    {
      "id": "SRC-0007/entity/rollout-cmd",
      "src": "SRC-0007",
      "composition": "entity",
      "terms": {
        "object": "RolloutCmd — команда для фоновой writer-task (через MPSC-канал)",
        "attributes": [
          "AddItems(Vec<RolloutItem>) — добавить items в буфер (без ack)",
          "Persist { ack: oneshot::Sender<io::Result<()>> } — материализовать файл и записать буфер",
          "Flush { ack: oneshot::Sender<io::Result<()>> } — дождаться записи всех буферизованных items",
          "Shutdown { ack: oneshot::Sender<io::Result<()>> } — записать остаток и закрыть writer"
        ],
        "relationships": [
          {"to": "SRC-0007/entity/rollout-writer-state", "rel": "processed_by", "card": "N:1"}
        ],
        "enumerations": {
          "variants": ["AddItems", "Persist", "Flush", "Shutdown"]
        },
        "data_flows": null,
        "config": null
      }
    },
    {
      "id": "SRC-0007/entity/event-persistence-mode",
      "src": "SRC-0007",
      "composition": "entity",
      "terms": {
        "object": "EventPersistenceMode — режим persistence для EventMsg в rollout-файле (минимум vs. расширенный набор событий)",
        "attributes": [
          "variant Limited (default): legacy минимальная поверхность событий",
          "variant Extended: расширенная поверхность (для app-server history reconstruction)"
        ],
        "relationships": [
          {"to": "SRC-0007/entity/rollout-recorder", "rel": "parameterizes", "card": "1:1"},
          {"to": "SRC-0007/entity/rollout-item", "rel": "filters", "card": "1:N"}
        ],
        "enumerations": {
          "EventPersistenceMode": ["Limited", "Extended"],
          "Limited persisted EventMsg (всегда)": [
            "UserMessage", "AgentMessage", "AgentReasoning", "AgentReasoningRawContent",
            "TokenCount", "ThreadNameUpdated", "ContextCompacted", "EnteredReviewMode",
            "ExitedReviewMode", "ThreadRolledBack", "UndoCompleted", "TurnAborted",
            "TurnStarted", "TurnComplete", "ImageGenerationEnd",
            "ItemCompleted(TurnItem::Plan) — только Plan-подвариант"
          ],
          "Extended-only persisted EventMsg (только в Extended режиме)": [
            "Error", "GuardianAssessment", "WebSearchEnd", "ExecCommandEnd", "PatchApplyEnd",
            "McpToolCallEnd", "ViewImageToolCall", "CollabAgentSpawnEnd",
            "CollabAgentInteractionEnd", "CollabWaitingEnd", "CollabCloseEnd",
            "CollabResumeEnd", "DynamicToolCallRequest", "DynamicToolCallResponse"
          ],
          "Never persisted EventMsg": [
            "Warning", "RealtimeConversationStarted", "RealtimeConversationSdp",
            "RealtimeConversationRealtime", "RealtimeConversationClosed", "ModelReroute",
            "AgentMessageDelta", "AgentReasoningDelta", "AgentReasoningRawContentDelta",
            "AgentReasoningSectionBreak", "RawResponseItem", "SessionConfigured",
            "McpToolCallBegin", "WebSearchBegin", "ExecCommandBegin", "TerminalInteraction",
            "ExecCommandOutputDelta", "ExecApprovalRequest", "RequestPermissions",
            "RequestUserInput", "ElicitationRequest", "ApplyPatchApprovalRequest",
            "BackgroundEvent", "StreamError", "PatchApplyBegin", "TurnDiff",
            "GetHistoryEntryResponse", "UndoStarted", "McpListToolsResponse",
            "RealtimeConversationListVoicesResponse", "McpStartupUpdate", "McpStartupComplete",
            "ListSkillsResponse", "PlanUpdate", "ShutdownComplete", "DeprecationNotice",
            "ItemStarted", "HookStarted", "HookCompleted", "AgentMessageContentDelta",
            "PlanDelta", "ReasoningContentDelta", "ReasoningRawContentDelta",
            "SkillsUpdateAvailable", "CollabAgentSpawnBegin", "CollabAgentInteractionBegin",
            "CollabWaitingBegin", "CollabCloseBegin", "CollabResumeBegin", "ImageGenerationBegin",
            "ItemCompleted (если item != TurnItem::Plan)"
          ]
        },
        "data_flows": null,
        "config": null
      }
    },
    {
      "id": "SRC-0007/entity/response-item-persist-policy",
      "src": "SRC-0007",
      "composition": "entity",
      "terms": {
        "object": "ResponseItem persistence policy — правила фильтрации ResponseItem для rollout и memories",
        "attributes": [
          "rollout persistence (should_persist_response_item): true для Message/Reasoning/LocalShellCall/FunctionCall/ToolSearchCall/FunctionCallOutput/ToolSearchOutput/CustomToolCall/CustomToolCallOutput/WebSearchCall/ImageGenerationCall/GhostSnapshot/Compaction; false для Other",
          "memories persistence (should_persist_response_item_for_memories): true для Message (если role != 'developer'), LocalShellCall, FunctionCall, ToolSearchCall, FunctionCallOutput, ToolSearchOutput, CustomToolCall, CustomToolCallOutput, WebSearchCall; false для Reasoning, ImageGenerationCall, GhostSnapshot, Compaction, Other"
        ],
        "relationships": [
          {"to": "SRC-0007/entity/rollout-item", "rel": "filters", "card": "1:N"}
        ],
        "enumerations": {
          "ResponseItem rollout-persisted": ["Message", "Reasoning", "LocalShellCall", "FunctionCall", "ToolSearchCall", "FunctionCallOutput", "ToolSearchOutput", "CustomToolCall", "CustomToolCallOutput", "WebSearchCall", "ImageGenerationCall", "GhostSnapshot", "Compaction"],
          "ResponseItem rollout-NOT-persisted": ["Other"],
          "ResponseItem memories-persisted": ["Message (role != 'developer')", "LocalShellCall", "FunctionCall", "ToolSearchCall", "FunctionCallOutput", "ToolSearchOutput", "CustomToolCall", "CustomToolCallOutput", "WebSearchCall"],
          "ResponseItem memories-NOT-persisted": ["Message (role == 'developer')", "Reasoning", "ImageGenerationCall", "GhostSnapshot", "Compaction", "Other"]
        },
        "data_flows": null,
        "config": null
      }
    },
    {
      "id": "SRC-0007/entity/thread-item",
      "src": "SRC-0007",
      "composition": "entity",
      "terms": {
        "object": "ThreadItem — summary одного rollout-файла для списочных операций",
        "attributes": [
          "path: PathBuf (абсолютный путь к rollout)",
          "thread_id: Option<ThreadId>",
          "first_user_message: Option<String>",
          "cwd: Option<PathBuf>",
          "git_branch: Option<String>",
          "git_sha: Option<String>",
          "git_origin_url: Option<String>",
          "source: Option<SessionSource>",
          "agent_nickname: Option<String>",
          "agent_role: Option<String>",
          "model_provider: Option<String>",
          "cli_version: Option<String>",
          "created_at: Option<String> (RFC3339, из filename timestamp, секундная точность)",
          "updated_at: Option<String> (RFC3339, из file mtime, millis precision)"
        ],
        "relationships": [
          {"to": "SRC-0007/entity/threads-page", "rel": "contained_in", "card": "N:1"},
          {"to": "SRC-0007/entity/rollout-file", "rel": "summarizes", "card": "1:1"}
        ],
        "enumerations": null,
        "data_flows": [
          {"source": "rollout file head (до 10 records, +200 при ожидании UserMessage)", "transform": "read_head_summary: парсит SessionMeta + первое UserMessage EventMsg, заполняет HeadTailSummary", "sink": "ThreadItem через build_thread_item"},
          {"source": "file mtime", "transform": "truncate_to_millis + format_rfc3339", "sink": "ThreadItem.updated_at"}
        ],
        "config": null
      }
    },
    {
      "id": "SRC-0007/entity/threads-page",
      "src": "SRC-0007",
      "composition": "entity",
      "terms": {
        "object": "ThreadsPage — страница списка thread-summaries с cursor-пагинацией",
        "attributes": [
          "items: Vec<ThreadItem> (ordered newest first)",
          "next_cursor: Option<Cursor> — токен для resume",
          "num_scanned_files: usize — сколько файлов было просмотрено в этом запросе",
          "reached_scan_cap: bool — true если hit MAX_SCAN_FILES"
        ],
        "relationships": [
          {"to": "SRC-0007/entity/thread-item", "rel": "contains", "card": "1:N"},
          {"to": "SRC-0007/entity/cursor", "rel": "paginates_via", "card": "1:0..1"}
        ],
        "enumerations": null,
        "data_flows": null,
        "config": null
      }
    },
    {
      "id": "SRC-0007/entity/cursor",
      "src": "SRC-0007",
      "composition": "entity",
      "terms": {
        "object": "Cursor — токен пагинации для ThreadsPage (timestamp + UUID)",
        "attributes": [
          "ts: OffsetDateTime",
          "id: Uuid",
          "serialized формат: '<ts_rfc3339>|<uuid>' (парсинг: split на '|', ts accepts RFC3339 или filename format YYYY-MM-DDThh-mm-ss)"
        ],
        "relationships": [
          {"to": "SRC-0007/entity/threads-page", "rel": "paginates", "card": "1:1"},
          {"to": "SRC-0007/entity/anchor-state", "rel": "consumed_by", "card": "1:1"}
        ],
        "enumerations": null,
        "data_flows": [
          {"source": "Cursor", "transform": "serialize: format '<ts>|<uuid>' / deserialize: parse_cursor split_once('|') → Uuid + (RFC3339 или filename ts format)", "sink": "opaque string token"},
          {"source": "codex_state::Anchor { ts, id }", "transform": "From<Anchor> — ts нано-секунды → OffsetDateTime.from_unix_timestamp_nanos (fallback UNIX_EPOCH)", "sink": "Cursor"}
        ],
        "config": null
      }
    },
    {
      "id": "SRC-0007/entity/anchor-state",
      "src": "SRC-0007",
      "composition": "entity",
      "terms": {
        "object": "AnchorState — state-машина пропуска элементов до прохождения cursor при пагинации",
        "attributes": [
          "ts: OffsetDateTime (из Cursor или UNIX_EPOCH если anchor=None)",
          "id: Uuid (из Cursor или Uuid::nil)",
          "passed: bool (true если уже прошли anchor point; если anchor=None → passed=true сразу)"
        ],
        "relationships": [
          {"to": "SRC-0007/entity/cursor", "rel": "initialized_from", "card": "1:1"}
        ],
        "enumerations": null,
        "data_flows": [
          {"source": "scan (ts, id) per file", "transform": "should_skip: если !passed и (ts < self.ts OR (ts == self.ts и id < self.id)) → passed=true, вернуть false; если ts>=self.ts и id>=self.id — вернуть true (skip)", "sink": "ControlFlow по паре"}
        ],
        "config": null
      }
    },
    {
      "id": "SRC-0007/entity/thread-list-config",
      "src": "SRC-0007",
      "composition": "entity",
      "terms": {
        "object": "ThreadListConfig — конфигурация запроса списка thread",
        "attributes": [
          "allowed_sources: &[SessionSource] — разрешённые источники (пустой = все)",
          "model_providers: Option<&[String]> — фильтр по провайдерам (None = все)",
          "default_provider: &str",
          "layout: ThreadListLayout (NestedByDate — ~/.codex/sessions/YYYY/MM/DD; Flat — плоская директория)"
        ],
        "relationships": [
          {"to": "SRC-0007/entity/threads-page", "rel": "parameterizes_scan_for", "card": "1:1"}
        ],
        "enumerations": {
          "ThreadListLayout": ["NestedByDate", "Flat"],
          "ThreadSortKey": ["CreatedAt", "UpdatedAt"]
        },
        "data_flows": null,
        "config": null
      }
    },
    {
      "id": "SRC-0007/entity/provider-matcher",
      "src": "SRC-0007",
      "composition": "entity",
      "terms": {
        "object": "ProviderMatcher — матчер для фильтрации rollout-файлов по model_provider",
        "attributes": [
          "filters: &[String] (None если filters.is_empty() → matcher не создаётся)",
          "matches_default_provider: bool (true если default_provider присутствует в filters)"
        ],
        "relationships": [
          {"to": "SRC-0007/entity/thread-list-config", "rel": "built_from", "card": "1:1"}
        ],
        "enumerations": null,
        "data_flows": [
          {"source": "session provider (Some(provider) из head summary)", "transform": "matches: Some(provider) → filters.any(candidate == provider); None → matches_default_provider", "sink": "bool (include/exclude ThreadItem)"}
        ],
        "config": null
      }
    },
    {
      "id": "SRC-0007/entity/session-index-entry",
      "src": "SRC-0007",
      "composition": "entity",
      "terms": {
        "object": "SessionIndexEntry — запись в append-only журнале session_index.jsonl (маппинг thread_id ↔ thread_name)",
        "attributes": [
          "id: ThreadId",
          "thread_name: String",
          "updated_at: String (RFC3339 UTC; 'unknown' если format failed)"
        ],
        "relationships": [
          {"to": "SRC-0007/entity/session-index", "rel": "appended_to", "card": "N:1"}
        ],
        "enumerations": null,
        "data_flows": [
          {"source": "append_thread_name(codex_home, thread_id, name)", "transform": "OffsetDateTime::now_utc().format(Rfc3339) → SessionIndexEntry → serde_json line + '\\n'", "sink": "session_index.jsonl (tokio create/append)"}
        ],
        "config": null
      }
    },
    {
      "id": "SRC-0007/entity/session-index",
      "src": "SRC-0007",
      "composition": "entity",
      "terms": {
        "object": "Session index (session_index.jsonl) — append-only файл-журнал, маппинг thread_id ↔ thread_name; последняя запись для id/name побеждает",
        "attributes": [
          "путь: <codex_home>/session_index.jsonl (константа SESSION_INDEX_FILE)",
          "READ_CHUNK_SIZE = 8192 байт (размер chunk при реверсивном сканировании)",
          "порядок: append-only, чтение от конца к началу (scan_index_from_end) для получения самой свежей записи"
        ],
        "relationships": [
          {"to": "SRC-0007/entity/session-index-entry", "rel": "contains", "card": "1:N"},
          {"to": "SRC-0007/entity/rollout-file", "rel": "indexes", "card": "1:1"}
        ],
        "enumerations": null,
        "data_flows": [
          {"source": "session_index.jsonl (reverse scan from end by 8192-byte chunks)", "transform": "parse_line_from_rev (reverse bytes до '\\n', UTF-8, serde_json::from_str<SessionIndexEntry>) + predicate (by_id или by_name)", "sink": "Option<SessionIndexEntry> / stream ThreadId через mpsc"}
        ],
        "config": null
      }
    },
    {
      "id": "SRC-0007/entity/thread-metadata-row",
      "src": "SRC-0007",
      "composition": "entity",
      "terms": {
        "object": "Thread metadata row (в SQLite state db) — SQLite-зеркало rollout metadata (id, path, cwd, provider, created/updated/archived_at, git, cli_version, agent fields, source, memory_mode, dynamic_tools)",
        "attributes": [
          "id: ThreadId",
          "rollout_path: PathBuf",
          "cwd: PathBuf (normalized через normalize_for_path_comparison при записи)",
          "model_provider: String",
          "created_at: DateTime<Utc>",
          "updated_at: DateTime<Utc>",
          "archived_at: Option<DateTime<Utc>>",
          "source: String",
          "agent_nickname, agent_role: Option<String>",
          "git_sha, git_branch, git_origin_url: Option<String>",
