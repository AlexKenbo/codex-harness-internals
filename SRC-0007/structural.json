        "data_flows": [
          {"source": "rollout file (read session meta + items)", "transform": "extract_metadata_from_rollout → ThreadMetadataBuilder → build + apply_rollout_item per item; cwd normalize; prefer_existing_git_info если row уже есть", "sink": "SQLite upsert_thread + set_thread_memory_mode + persist_dynamic_tools"},
          {"source": "rollout write (record_items)", "transform": "sync_thread_state_after_write: apply_rollout_items (если items affect metadata или new_memory_mode) ИНАЧЕ touch_thread_updated_at (lightweight timestamp update)", "sink": "SQLite"},
          {"source": "filesystem fallback после stale/missing DB path", "transform": "read_repair_rollout_path: fast path (clone + update rollout_path + cwd normalize + archived_at handling; skip if equal) / slow path (reconcile_rollout через extract)", "sink": "SQLite upsert (warn 'state db discrepancy ... upsert_needed fast path/slow path')"}
        ],
        "config": null
      }
