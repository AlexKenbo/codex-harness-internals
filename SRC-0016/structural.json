    {
      "id": "SRC-0016/entity/mcp-resource-args",
      "src": "SRC-0016",
      "composition": "entity",
      "terms": {
        "object": "MCP resource arguments",
        "attributes": [
          "ListResourcesArgs: { server: Option<String>, cursor: Option<String> }",
          "ListResourceTemplatesArgs: { server: Option<String>, cursor: Option<String> }",
          "ReadResourceArgs: { server: String (required, non-empty), uri: String (required, non-empty) }"
        ],
        "relationships": [
          {"to": "SRC-0016/entity/mcp-resource-payload", "rel": "produces", "card": "1:1"}
        ],
        "enumerations": {
          "tool_name dispatch (McpResourceHandler)": ["list_mcp_resources", "list_mcp_resource_templates", "read_mcp_resource"]
        },
        "data_flows": [
          {"source": "arguments (Option<Value>)", "transform": "parse_args_with_default (Default when None) | parse_args (error when None)", "sink": "typed args"},
          {"source": "raw String input", "transform": "normalize_optional_string (trim; empty -> None) | normalize_required_string (error when empty)", "sink": "validated String | Option<String>"}
        ],
        "config": null
      }
    },
    {
      "id": "SRC-0016/entity/mcp-resource-payload",
      "src": "SRC-0016",
      "composition": "entity",
      "terms": {
        "object": "MCP resource response payloads",
        "attributes": [
          "ListResourcesPayload: { server: Option<String>, resources: Vec<ResourceWithServer>, next_cursor: Option<String> }",
          "ListResourceTemplatesPayload: { server: Option<String>, resource_templates: Vec<ResourceTemplateWithServer>, next_cursor: Option<String> }",
          "ReadResourcePayload: { server, uri, ...ReadResourceResult (flattened) }",
          "ResourceWithServer: { server, ...Resource }",
          "ResourceTemplateWithServer: { server, ...ResourceTemplate }"
        ],
        "relationships": [],
        "enumerations": null,
        "data_flows": [
          {"source": "single server: session.list_resources(server, PaginatedRequestParams{cursor})", "transform": "from_single_server (attach server to each resource + propagate next_cursor)", "sink": "ListResourcesPayload"},
          {"source": "all servers: mcp_connection_manager.list_all_resources (HashMap<server, resources>)", "transform": "from_all_servers (sort entries by server, flatten, next_cursor=None)", "sink": "ListResourcesPayload"},
          {"source": "session.list_resource_templates(server, params) or list_all_resource_templates", "transform": "analogous to resources", "sink": "ListResourceTemplatesPayload"},
          {"source": "session.read_resource(server, ReadResourceRequestParams{uri})", "transform": "wrap in ReadResourcePayload", "sink": "ReadResourcePayload"},
          {"source": "payload", "transform": "serialize_function_output (serde_json::to_string) -> FunctionToolOutput::from_text(content, success=Some(true))", "sink": "FunctionToolOutput"},
          {"source": "FunctionToolOutput.body", "transform": "function_call_output_content_items_to_text + call_tool_result_from_content", "sink": "CallToolResult for emit_tool_call_end"}
        ],
        "config": {
          "default_server_for_event": {"value": "codex", "source": "hardcoded fallback in handle_list_resources/templates when server is None", "default": "codex"}
        }
      }
    },
    {
