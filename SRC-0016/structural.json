      "src": "SRC-0016",
      "composition": "entity",
      "terms": {
        "object": "EffectiveAdditionalPermissions",
        "attributes": [
          "sandbox_permissions: SandboxPermissions (possibly promoted to WithAdditionalPermissions)",
          "additional_permissions: Option<PermissionProfile> (merged session + turn + inline)",
          "permissions_preapproved: bool (true iff intersect(effective, granted)==effective)"
        ],
        "relationships": [
          {"to": "SRC-0016/entity/additional-permissions", "rel": "contains", "card": "1:1"}
        ],
        "enumerations": {
          "SandboxPermissions (referenced)": ["UseDefault", "WithAdditionalPermissions", "RequireEscalated"]
        },
        "data_flows": [
          {"source": "session.granted_session_permissions + granted_turn_permissions", "transform": "merge_permission_profiles", "sink": "granted_permissions"},
          {"source": "additional_permissions + granted_permissions", "transform": "merge_permission_profiles", "sink": "effective_permissions"},
          {"source": "effective_permissions, granted_permissions", "transform": "intersect_permission_profiles(effective, granted) == effective", "sink": "permissions_preapproved"},
          {"source": "sandbox_permissions + effective_permissions", "transform": "if effective_permissions.is_some() && !uses_additional_permissions -> promote to WithAdditionalPermissions", "sink": "sandbox_permissions"},
          {"source": "sandbox_permissions=RequireEscalated", "transform": "early-return bypasses session grants merge; preapproved=false", "sink": "EffectiveAdditionalPermissions"}
        ],
        "config": null
      }
    },
