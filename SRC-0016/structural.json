        "config": null
      }
    },
    {
      "id": "SRC-0016/entity/tool-payload",
      "src": "SRC-0016",
      "composition": "entity",
      "terms": {
        "object": "ToolPayload",
        "attributes": [
          "variant Function { arguments: String (JSON) }",
          "variant Custom { input: String (freeform text) }",
          "variant Mcp { server, tool, raw_arguments }",
          "variant LocalShell { params: ShellToolCallParams }",
          "variant ToolSearch { arguments: ToolSearchArgs }"
        ],
        "relationships": [],
        "enumerations": {
          "ToolPayload variants": ["Function", "Custom", "Mcp", "LocalShell", "ToolSearch"]
        },
        "data_flows": [
          {"source": "ToolPayload::Function.arguments", "transform": "parse_arguments (serde_json::from_str)", "sink": "typed args struct"},
          {"source": "ToolPayload::Function.arguments", "transform": "parse_arguments_with_base_path (guarded by AbsolutePathBufGuard)", "sink": "typed args struct with relative-path resolution"}
        ],
        "config": null
      }
    },
    {
      "id": "SRC-0016/entity/apply-patch-invocation",
      "src": "SRC-0016",
      "composition": "entity",
      "terms": {
        "object": "ApplyPatch invocation",
        "attributes": [
          "patch_input: String (from ApplyPatchToolArgs.input or Custom.input)",
          "cwd: AbsolutePathBuf (from turn.cwd)",
          "file_paths: Vec<AbsolutePathBuf> (derived via file_paths_for_action)",
          "action: ApplyPatchAction (changes: map of path -> ApplyPatchFileChange)",
          "effective_additional_permissions: EffectiveAdditionalPermissions",
          "file_system_sandbox_policy: FileSystemSandboxPolicy",
          "auto_approved: bool"
        ],
        "relationships": [
          {"to": "SRC-0016/entity/effective-additional-permissions", "rel": "uses", "card": "1:1"},
          {"to": "SRC-0016/entity/apply-patch-request", "rel": "converts_to", "card": "1:1"}
        ],
        "enumerations": {
          "ApplyPatchFileChange variants (referenced)": ["Add", "Delete", "Update (with optional move_path)"],
          "MaybeApplyPatchVerified variants": ["Body", "CorrectnessError", "ShellParseError", "NotApplyPatch"],
          "InternalApplyPatchInvocation variants": ["Output", "DelegateToRuntime"]
        },
        "data_flows": [
          {"source": "patch_input", "transform": "maybe_parse_apply_patch_verified(cwd, fs, sandbox)", "sink": "ApplyPatchAction.changes"},
          {"source": "ApplyPatchAction.changes", "transform": "file_paths_for_action (collects paths + Update.move_path via to_abs_path)", "sink": "file_paths"},
          {"source": "file_paths", "transform": "write_permissions_for_paths (filter paths whose parent cannot write per sandbox policy) + normalize_additional_permissions", "sink": "PermissionProfile (write-only)"},
          {"source": "ApplyPatchAction", "transform": "convert_apply_patch_to_protocol", "sink": "protocol-level changes for emitter"}
        ],
        "config": null
      }
    },
    {
      "id": "SRC-0016/entity/apply-patch-request",
      "src": "SRC-0016",
      "composition": "entity",
      "terms": {
        "object": "ApplyPatchRequest (delegated to ApplyPatchRuntime)",
        "attributes": [
          "action: ApplyPatchAction",
          "file_paths: Vec<AbsolutePathBuf>",
          "changes: protocol changes",
          "exec_approval_requirement",
          "additional_permissions: Option<PermissionProfile>",
          "permissions_preapproved: bool"
        ],
        "relationships": [
          {"to": "SRC-0016/entity/apply-patch-invocation", "rel": "derived_from", "card": "1:1"}
        ],
        "enumerations": null,
        "data_flows": [
          {"source": "ApplyPatchRequest", "transform": "ToolOrchestrator.run(ApplyPatchRuntime)", "sink": "runtime result.output -> ApplyPatchToolOutput"}
        ],
        "config": null
      }
    },
    {
      "id": "SRC-0016/entity/dynamic-tool-call",
      "src": "SRC-0016",
      "composition": "entity",
      "terms": {
        "object": "Dynamic tool call (client-side tool)",
        "attributes": [
          "call_id: String",
          "turn_id: String (from turn_context.sub_id)",
          "tool: String (tool_name)",
          "arguments: serde_json::Value",
          "started_at: Instant",
          "tx_response: oneshot::Sender<DynamicToolResponse> (pending entry in active turn state)"
        ],
        "relationships": [
          {"to": "SRC-0016/entity/dynamic-tool-response", "rel": "awaits", "card": "1:1"}
        ],
        "enumerations": null,
        "data_flows": [
          {"source": "ToolPayload::Function.arguments", "transform": "parse_arguments -> serde_json::Value", "sink": "DynamicToolCallRequest event"},
          {"source": "session.active_turn.turn_state", "transform": "insert_pending_dynamic_tool(call_id, tx_response)", "sink": "pending dynamic tool registry"},
          {"source": "EventMsg::DynamicToolCallRequest", "transform": "session.send_event", "sink": "client"},
          {"source": "rx_response (oneshot)", "transform": "await client response (or None=cancelled)", "sink": "DynamicToolResponse OR DynamicToolCallResponseEvent with error"}
        ],
        "config": null
      }
    },
    {
      "id": "SRC-0016/entity/dynamic-tool-response",
      "src": "SRC-0016",
      "composition": "entity",
      "terms": {
        "object": "DynamicToolResponse",
        "attributes": [
          "content_items: Vec<FunctionCallOutputContentItem>",
          "success: bool",
          "error: Option<String> (in DynamicToolCallResponseEvent when cancelled)",
