        ],
        "relationships": [],
        "enumerations": null,
        "data_flows": [
          {"source": "DynamicToolResponse.content_items", "transform": "map FunctionCallOutputContentItem::from + FunctionToolOutput::from_content", "sink": "FunctionToolOutput"}
        ],
        "config": null
      }
    },
    {
      "id": "SRC-0016/entity/js-repl-args",
      "src": "SRC-0016",
      "composition": "entity",
      "terms": {
