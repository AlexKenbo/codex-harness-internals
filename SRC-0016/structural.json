          {"source": "ToolPayload::Function.arguments", "transform": "parse_arguments (JSON)", "sink": "JsReplArgs"},
          {"source": "ToolPayload::Custom.input", "transform": "parse_freeform_args (first line pragma `// codex-js-repl: timeout_ms=N` + JS body)", "sink": "JsReplArgs"},
          {"source": "Custom.input (trimmed)", "transform": "reject_json_or_quoted_source (rejects ``` markdown fences and JSON object/string)", "sink": "validation error OR accepted code"}
        ],
        "config": null
      }
    },
    {
      "id": "SRC-0016/entity/js-repl-invocation",
      "src": "SRC-0016",
      "composition": "entity",
      "terms": {
        "object": "JS REPL invocation",
        "attributes": [
          "feature: Feature::JsRepl (must be enabled)",
          "manager: obtained via turn.js_repl.manager()",
