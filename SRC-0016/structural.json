{
  "src": "SRC-0016",
  "schema_version": "2.0",
  "lens": "structural",
  "compositions": [
    {
      "id": "SRC-0016/entity/tool-handler-registry",
      "src": "SRC-0016",
      "composition": "entity",
      "terms": {
        "object": "ToolHandler set (core handlers)",
        "attributes": [
          "ApplyPatchHandler: kind=Function, is_mutating=true, accepts Function|Custom payload",
          "DynamicToolHandler: kind=Function, is_mutating=true, accepts Function payload",
          "JsReplHandler: kind=Function, accepts Function|Custom payload, feature-gated by JsRepl",
          "JsReplResetHandler: kind=Function, feature-gated by JsRepl",
          "ListDirHandler: kind=Function, accepts Function payload",
          "McpHandler: kind=Mcp, accepts Mcp payload",
          "McpResourceHandler: kind=Function, accepts Function payload, dispatches by tool_name",
          "PlanHandler: kind=Function, accepts Function payload",
          "RequestPermissionsHandler: kind=Function, accepts Function payload",
          "RequestUserInputHandler: kind=Function, accepts Function payload, root-thread-only",
          "ShellHandler: kind=Function, accepts Function|LocalShell payload, is_mutating=based on is_known_safe_command",
          "ShellCommandHandler: kind=Function, accepts Function payload, backend: Classic|ZshFork",
          "TestSyncHandler: kind=Function, accepts Function payload",
          "ToolSearchHandler: kind=Function, accepts ToolSearch payload",
          "ToolSuggestHandler: kind=Function, accepts Function payload",
          "UnavailableToolHandler: kind=Function, accepts Function payload, success=false",
          "UnifiedExecHandler: kind=Function, accepts Function payload, is_mutating=based on is_known_safe_command, dispatches exec_command|write_stdin",
          "ViewImageHandler: kind=Function, accepts Function payload, requires Image modality support"
        ],
        "relationships": [
          {"to": "SRC-0016/entity/tool-invocation", "rel": "consumes", "card": "N:1"},
          {"to": "SRC-0016/entity/tool-payload", "rel": "dispatches_on", "card": "N:1"}
        ],
        "enumerations": {
          "ToolKind": ["Function", "Mcp"],
          "ShellCommandBackend": ["Classic", "ZshFork"],
          "ShellRuntimeBackend": ["Generic", "ShellCommandClassic", "ShellCommandZshFork"]
        },
        "data_flows": [
          {"source": "ToolInvocation", "transform": "handler.handle()", "sink": "handler-specific Output (FunctionToolOutput | McpToolOutput | ApplyPatchToolOutput | ExecCommandToolOutput | ToolSearchOutput | ViewImageOutput | PlanToolOutput)"}
        ],
        "config": null
      }
    },
    {
