    {
      "id": "SRC-0016/entity/shell-invocation",
      "src": "SRC-0016",
      "composition": "entity",
      "terms": {
        "object": "Shell / ShellCommand invocation",
        "attributes": [
          "command: Vec<String>",
          "cwd: AbsolutePathBuf (resolved via turn.resolve_path(params.workdir))",
          "expiration / timeout_ms",
