          "timed_out: bool"
        ],
        "relationships": [],
        "enumerations": null,
        "data_flows": [
          {"source": "stdout, stderr", "transform": "join_outputs (empty-safe concatenation with \\n separator)", "sink": "aggregated_output"}
        ],
        "config": null
      }
    },
    {
      "id": "SRC-0016/entity/list-dir-args",
      "src": "SRC-0016",
      "composition": "entity",
      "terms": {
        "object": "ListDirArgs",
        "attributes": [
          "dir_path: String (must be absolute path)",
          "offset: usize (1-indexed, default 1)",
          "limit: usize (default 25)",
          "depth: usize (default 2)"
        ],
        "relationships": [
          {"to": "SRC-0016/entity/dir-entry", "rel": "produces", "card": "1:N"}
        ],
        "enumerations": null,
        "data_flows": [
          {"source": "filesystem via tokio::fs::read_dir (BFS queue with remaining_depth)", "transform": "collect_entries -> DirEntry { name, display_name, depth, kind }; sort by name; paginate by offset/limit", "sink": "formatted text lines with indentation (2 spaces per depth) + suffix (/ @ ? empty)"}
        ],
        "config": {
          "default_offset": {"value": 1, "source": "hardcoded default_offset()", "default": 1},
          "default_limit": {"value": 25, "source": "hardcoded default_limit()", "default": 25},
          "default_depth": {"value": 2, "source": "hardcoded default_depth()", "default": 2},
          "MAX_ENTRY_LENGTH": {"value": 500, "source": "hardcoded const", "default": 500},
          "INDENTATION_SPACES": {"value": 2, "source": "hardcoded const", "default": 2}
        }
      }
    },
    {
      "id": "SRC-0016/entity/dir-entry",
      "src": "SRC-0016",
      "composition": "entity",
      "terms": {
        "object": "DirEntry",
        "attributes": [
          "name: String (sort key, normalized relative path, max 500 bytes at char boundary)",
          "display_name: String (final path component, normalized, max 500 bytes)",
          "depth: usize (prefix components count)",
          "kind: DirEntryKind"
        ],
        "relationships": [],
        "enumerations": {
          "DirEntryKind": ["Directory", "File", "Symlink", "Other"],
          "DirEntryKind.suffix (in format_entry_line)": ["Directory=/", "Symlink=@", "Other=?", "File=(no suffix)"]
        },
        "data_flows": [
          {"source": "std::fs::FileType", "transform": "From<&FileType>: is_symlink -> Symlink, is_dir -> Directory, is_file -> File, else Other", "sink": "DirEntryKind"}
        ],
        "config": null
      }
    },
