        "relationships": [
          {"to": "SRC-0016/entity/shell-request", "rel": "converts_to", "card": "1:1"},
          {"to": "SRC-0016/entity/effective-additional-permissions", "rel": "uses", "card": "1:1"}
        ],
        "enumerations": null,
        "data_flows": [
          {"source": "ShellToolCallParams | ShellCommandToolCallParams", "transform": "to_exec_params (+ resolve_use_login_shell for ShellCommandHandler)", "sink": "ExecParams"},
          {"source": "ExecParams + session.dependency_env", "transform": "extend env; collect explicit_env_overrides (union of turn.set and keys from dependency_env)", "sink": "env + explicit_env_overrides"},
          {"source": "exec_params.command", "transform": "intercept_apply_patch (if apply_patch present, delegate to apply_patch pipeline and return early)", "sink": "Option<FunctionToolOutput>"},
          {"source": "command + cwd + sandbox_policy + sandbox_permissions + prefix_rule + approval_policy + file_system_sandbox_policy", "transform": "exec_policy.create_exec_approval_requirement_for_command", "sink": "exec_approval_requirement"},
          {"source": "ShellRequest", "transform": "ToolOrchestrator.run(ShellRuntime)", "sink": "result.output"},
          {"source": "emitter begin/finish + output", "transform": "format_exec_output_str(output, turn.truncation_policy)", "sink": "post_tool_use_response (JsonValue::String)"}
        ],
        "config": null
      }
    },
