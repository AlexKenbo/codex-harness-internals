          {"to": "SRC-0016/entity/exec-tool-call-output", "rel": "produces", "card": "1:1"}
        ],
        "enumerations": null,
        "data_flows": [
          {"source": "js_repl manager", "transform": "manager.execute(session, turn, tracker, args)", "sink": "result (output + content_items)"},
          {"source": "output/error + duration", "transform": "build_js_repl_exec_output (exit_code=1 if error else 0, timed_out=false)", "sink": "ExecToolCallOutput"},
          {"source": "ExecToolCallOutput", "transform": "ToolEmitter::shell + emit Begin/Success/Failure", "sink": "ToolEventCtx events"}
        ],
        "config": null
      }
